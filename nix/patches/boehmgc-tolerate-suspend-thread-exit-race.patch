--- a/pthread_stop_world.c	2026-08-15 19:24:37.312809840 +0200
+++ b/pthread_stop_world.c	2026-08-15 19:24:57.337516440 +0200
@@ -983,7 +983,25 @@
               result = raise_signal(p, GC_sig_suspend);
               switch(result) {
                 case ESRCH:
+                case EINVAL:
                     /* Not really there anymore.  Possible? */
+                    /* EINVAL can also reach here: pthread_kill()/tgkill()
+                       on a thread id whose underlying OS resources the
+                       kernel has already reclaimed is undefined by POSIX,
+                       and depending on glibc/kernel version may surface
+                       as EINVAL rather than ESRCH. GC_sig_suspend is a
+                       fixed, valid signal number for the process's whole
+                       lifetime, so EINVAL here cannot mean "bad signal
+                       number" -- treat it the same as "thread already
+                       gone". */
+                    /* Say so. This branch leaves the thread unsuspended
+                       and leaves its entry in GC_threads, so the stack of
+                       that thread is not pushed for this collection. When
+                       the thread really is gone that is correct. When it
+                       is not, the collection frees whatever only that
+                       stack refers to, and nothing else reports it. */
+                    GC_COND_LOG_PRINTF("Skipped a thread at suspend:"
+                                       " errcode= %d\n", result);
                     n_live_threads--;
                     break;
                 case 0:
